#!/bin/sh
# 推送前：重新构建 + 量图有没有画坏。
# 安装：npm install 时自动执行 git config core.hooksPath .githooks
echo "  pre-push: 重新构建…"
npm run --silent build:standalone >/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "  ✗ 构建失败，已阻止推送。手动跑 npm run build 看错误。"
  exit 1
fi
if ! git diff --quiet -- index.html notes dist; then
  echo "  ✗ 构建产物有变化（note.md 改了但没提交构建结果）。"
  echo "    请执行：git add -A && git commit --amend --no-edit   然后重新 push"
  exit 1
fi
echo "  pre-push: 量图的布局…"
npm run --silent visual-check
if [ $? -ne 0 ]; then
  echo "  ✗ 有图被画坏了，已阻止推送。构建通过不等于画对了。"
  exit 1
fi
