#!/bin/sh
# 推送前重新构建，防止「改了 note.md 忘了 build」导致线上是旧内容。
# 安装：npm install 时会自动执行 git config core.hooksPath .githooks
echo "  pre-push: 重新构建…"
npm run --silent build:standalone >/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "  ✗ 构建失败，已阻止推送。手动跑 npm run build 看错误。"
  exit 1
fi
if ! git diff --quiet -- index.html notes dist; then
  echo "  ✗ 构建产物有变化（note.md 改了但没提交构建结果）。"
  echo "    请执行：git add -A && git commit --amend --no-edit   然后重新 push"
  exit 1
fi
echo "  ✓ 构建产物已是最新"
