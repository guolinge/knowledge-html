{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "磁盘上的层，和容器进程看到的 /，是两套东西",
    "subtitle": "「叠」不是复制合并，是一条查找规则：从最上层往下问，谁先有算谁的",
    "output": "docker-layer-view.html",
    "quality_profile": "showcase"
  },
  "layout": {
    "mode": "grid",
    "origin": [
      56,
      118
    ],
    "cols": 3,
    "gapX": 150,
    "gapY": 46,
    "cellW": 196,
    "cellH": 74
  },
  "boundaries": [
    {
      "kind": "region",
      "label": "宿主机磁盘 —— 只读层全镜像共享，可写层每个容器一份",
      "wraps": [
        "rw",
        "l3",
        "l2",
        "l1"
      ]
    },
    {
      "kind": "region",
      "label": "容器里那个 Java 进程看到的 / —— 这就是 rootfs",
      "wraps": [
        "root",
        "jar",
        "osr",
        "base"
      ]
    }
  ],
  "components": [
    {
      "id": "rw",
      "type": "backend",
      "label": "可写层",
      "sublabel": "刚启动时是空的",
      "row": 0,
      "col": 0
    },
    {
      "id": "l3",
      "type": "database",
      "label": "层 3 · 应用",
      "sublabel": "COPY app.jar /app/",
      "row": 1,
      "col": 0
    },
    {
      "id": "l2",
      "type": "database",
      "label": "层 2 · JDK",
      "sublabel": "apt install openjdk-17",
      "row": 2,
      "col": 0
    },
    {
      "id": "l1",
      "type": "database",
      "label": "层 1 · 基础系统",
      "sublabel": "FROM debian:12",
      "row": 3,
      "col": 0
    },
    {
      "id": "jar",
      "type": "external",
      "label": "/app/app.jar",
      "sublabel": "只有层 3 有",
      "row": 1,
      "col": 2
    },
    {
      "id": "osr",
      "type": "external",
      "label": "/etc/os-release",
      "sublabel": "读到的是层 2 那份",
      "row": 2,
      "col": 2
    },
    {
      "id": "base",
      "type": "external",
      "label": "/etc · /bin · /usr",
      "sublabel": "层 1 打底，层 2 加了东西",
      "row": 3,
      "col": 2
    },
    {
      "id": "root",
      "type": "external",
      "label": "/",
      "sublabel": "合并出来的根",
      "row": 0,
      "col": 2
    }
  ],
  "connections": [
    {
      "id": "e0",
      "from": "rw",
      "to": "root",
      "label": "刚启动时它还是空的，你写的第一个文件才会出现在这",
      "variant": "dashed",
      "labelDy": 34
    },
    {
      "id": "e1",
      "from": "l3",
      "to": "jar",
      "label": "只有它能提供这个路径",
      "variant": "emphasis"
    },
    {
      "id": "e2",
      "from": "l2",
      "to": "osr",
      "label": "层 1 也有同名文件，被这一份盖住",
      "variant": "emphasis"
    },
    {
      "id": "e3",
      "from": "l1",
      "to": "base",
      "label": "整棵树由它打底"
    }
  ]
}
