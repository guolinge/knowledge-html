{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "一次快照的七个状态",
    "output": "snapshot-states.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "正常路径"
    },
    {
      "id": "wait",
      "label": "等一会儿"
    },
    {
      "id": "terminal",
      "label": "终止"
    }
  ],
  "states": [
    {
      "id": "init",
      "type": "start",
      "label": "INIT",
      "sublabel": "已建任务，等人来抢",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "creating",
      "type": "active",
      "label": "CREATING",
      "sublabel": "已抢占，正在下 JOB",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "submitted",
      "type": "active",
      "label": "SUBMITTED",
      "sublabel": "JOB 已提交，等它跑",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "running",
      "type": "active",
      "label": "RUNNING",
      "sublabel": "Doris 正在写",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "success",
      "type": "success",
      "label": "SUCCESS",
      "sublabel": "写完，行数已记",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "retry",
      "type": "waiting",
      "label": "RETRY_WAIT",
      "sublabel": "等 10/20/40 秒再试",
      "lane": "wait",
      "col": 0
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "FAILED",
      "sublabel": "不再重试，等人工",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "init",
      "to": "creating"
    },
    {
      "id": "t2",
      "from": "creating",
      "to": "submitted"
    },
    {
      "id": "t3",
      "from": "submitted",
      "to": "running"
    },
    {
      "id": "t4",
      "from": "running",
      "to": "success",
      "variant": "emphasis"
    },
    {
      "id": "t5",
      "from": "creating",
      "to": "retry",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "t7",
      "from": "retry",
      "to": "creating",
      "variant": "emphasis",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "t6",
      "from": "running",
      "to": "retry",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "t8",
      "from": "retry",
      "to": "failed",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "正常路径",
      "items": [
        "INIT → CREATING → SUBMITTED → RUNNING → SUCCESS 五个状态一条直线",
        "全程由三个后台 worker 推动，没有人在等它",
        "SUCCESS 时才去数一次真实行数，写进 result_row_count"
      ]
    },
    {
      "dot": "amber",
      "title": "重试只给三次",
      "items": [
        "可重试的错 → RETRY_WAIT，退避 10 / 20 / 40 秒",
        "MAX_ATTEMPTS = 4，试满就 FAILED",
        "为什么这么急？因为分区只活 5 分钟 —— 见下一节"
      ]
    },
    {
      "dot": "rose",
      "title": "有些错不能重试",
      "items": [
        "下 JOB 的时候就失败（确定没写）→ 可以重试",
        "「结果未知」（可能写了）→ 直接 FAILED，不重试",
        "宁可报失败让人看，也不能悄悄写重"
      ]
    }
  ]
}
