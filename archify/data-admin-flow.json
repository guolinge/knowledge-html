{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "配置怎么流到界面：写在一侧，读在另一侧",
    "output": "data-admin-flow.html",
    "quality_profile": "showcase"
  },
  "components": [
    {
      "id": "admin",
      "type": "external",
      "label": "Data Admin",
      "sublabel": "配置台 · 运营在这配",
      "row": 0,
      "col": 0,
      "tag": "唯一能改的地方"
    },
    {
      "id": "mysql",
      "type": "database",
      "label": "MySQL crm_dc",
      "sublabel": "5 张元数据表",
      "row": 0,
      "col": 1
    },
    {
      "id": "be",
      "type": "backend",
      "label": "后端 Catalog",
      "sublabel": "/api/meta/catalog",
      "row": 0,
      "col": 2
    },
    {
      "id": "fe",
      "type": "external",
      "label": "圈选界面",
      "sublabel": "下拉框 / 操作符 / 表头",
      "row": 0,
      "col": 3,
      "tag": "浏览器里看到的"
    },
    {
      "id": "doris",
      "type": "cloud",
      "label": "Doris crm_insight",
      "sublabel": "100 万条人像",
      "row": 1,
      "col": 3
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "① 写 —— 只有 Data Admin 能改",
      "wraps": [
        "admin",
        "mysql"
      ]
    },
    {
      "kind": "security-group",
      "label": "② 读 —— 界面只能看，改不了",
      "wraps": [
        "be",
        "fe"
      ]
    }
  ],
  "connections": [
    {
      "id": "c1",
      "from": "admin",
      "to": "mysql",
      "label": "INSERT / UPDATE"
    },
    {
      "id": "c2",
      "from": "mysql",
      "to": "be",
      "label": "SELECT 只读",
      "variant": "emphasis"
    },
    {
      "id": "c3",
      "from": "be",
      "to": "fe",
      "label": "一份 JSON"
    },
    {
      "id": "c4",
      "from": "fe",
      "to": "doris",
      "label": "点「查询」才走这条",
      "variant": "dashed",
      "labelDy": 34
    }
  ],
  "layout": {
    "mode": "grid",
    "origin": [
      60,
      90
    ],
    "cols": 4,
    "gapX": 56,
    "gapY": 150,
    "cellW": 190,
    "cellH": 64
  }
