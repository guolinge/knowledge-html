{
  "name": "knowledge-html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "用 HTML 讲清楚一个知识点的个人知识库：Markdown 为源，构建出可离线打开的单文件页面",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "new": "node tools/new.mjs",
    "build": "node tools/render.mjs",
    "build:standalone": "node tools/render.mjs --standalone",
    "check": "node tools/render.mjs --check && node tools/skill-check.mjs",
    "visual-check": "node tools/visual-check.mjs",
    "view": "node tools/view.mjs",
    "serve": "node tools/serve.mjs",
    "skill-check": "node tools/skill-check.mjs",
    "skill": "node tools/skill-view.mjs"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.6.0"
  }
}
