<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="query" value="按 email 查询整行" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="40" y="40" width="140" height="60" />
    </mxCell>
    <mxCell id="secondary" value="二级索引导航&#10;email 键 + 子页号" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="220" y="40" width="140" height="60" />
    </mxCell>
    <mxCell id="sec-leaf" value="二级索引叶子&#10;email + id=42" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="220" y="160" width="140" height="60" />
    </mxCell>
    <mxCell id="cluster" value="按主键回表&#10;id 键 + 子页号" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="400" y="160" width="140" height="60" />
    </mxCell>
    <mxCell id="row" value="聚簇索引叶子&#10;id=42 + 行记录" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="400" y="280" width="140" height="60" />
    </mxCell>
    <mxCell id="result" value="返回所需列" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="580" y="280" width="140" height="60" />
    </mxCell>
    <mxCell id="e0" value="定位" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="query" target="secondary" parent="1">
      <mxGeometry as="geometry" relative="1" />
    </mxCell>
    <mxCell id="e1" value="选子页" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="secondary" target="sec-leaf" parent="1">
      <mxGeometry as="geometry" relative="1" />
    </mxCell>
    <mxCell id="e2" value="主键引用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="sec-leaf" target="cluster" parent="1">
      <mxGeometry as="geometry" relative="1" />
    </mxCell>
    <mxCell id="e3" value="选子页" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="cluster" target="row" parent="1">
      <mxGeometry as="geometry" relative="1" />
    </mxCell>
    <mxCell id="e4" value="取行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" source="row" target="result" parent="1">
      <mxGeometry as="geometry" relative="1" />
    </mxCell>
  </root>
</mxGraphModel>